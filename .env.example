APP_NAME=ProofPatcher
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

# Set once by the operator to enable GitHub device sign-in.
PROOFPATCH_GITHUB_CLIENT_ID=
# Web sign-in only: GitHub App client secret (GitHub App settings > General).
# Keep out of source control; the terminal device flow does not need it.
PROOFPATCH_GITHUB_CLIENT_SECRET=

# Local model request count; the separate $0.50 estimated reservation limit remains in force.
# Optional explicit request cap. Leave unset for metering-only usage;
# provider quotas (Baseten/Modal/Meta) are the limit.
# PROOFPATCH_MODEL_MAX_ATTEMPTS=

# Optional exact allowlist for the dedicated test workflow; leave empty to disable it.
PROOFPATCH_TEST_REPO=
PROOFPATCH_TEST_BASE_COMMIT=
